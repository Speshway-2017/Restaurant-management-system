{
  "name": "flavora-receptionist-desktop",
  "version": "1.0.0",
  "description": "Flavora Restaurant Management System - Receptionist Desktop Command Center",
  "main": "main.js",
  "author": "Speshway / Flavora Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "electron-winstaller@5.4.0": true
  },

  "build": {
    "appId": "com.speshway.flavora.receptionist",
    "productName": "Flavora Receptionist",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!dist/**"
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
